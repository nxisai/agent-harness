# Copy to .env.local, which is gitignored. Never commit a real key, and never
# put one in compose.yaml: values there are visible to anyone who can read the
# repo, and `docker compose config` prints them.

# --- Credentials. Only the models you intend to run need one. ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Vendor model ids the registry leaves open, so a wrong id fails loudly. ---
OPENAI_MODEL=
OPENAI_DISPLAY=
GOOGLE_MODEL=
GOOGLE_DISPLAY=

# --- Behaviour ---
# Which model answers when the caller names none.
DEFAULT_MODEL=claude-sonnet
# Origins allowed to post here. The tunnel's own origin is required when the
# page is served through ngrok: the browser sends the tunnel's Origin, not
# localhost's.
ALLOWED_ORIGINS=http://localhost:3000,https://your-tunnel.example
# Per-client budget. The proof that it is enforced is in the skill's host profile.
RATE_LIMIT_PER_MIN=20
RATE_LIMIT_WINDOW_SEC=60
# Only set this true behind a reverse proxy you control. Exposed directly, it
# lets any caller choose its own rate-limit bucket.
TRUST_PROXY=false
# Ceiling on generated tokens per turn.
MAX_TOKENS=4096
# Where Anthropic is reached, for the page's calls and a remote agent's alike.
# Leave unset for Anthropic's own API.
# ANTHROPIC_BASE_URL=
