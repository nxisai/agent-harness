{
  "name": "@nxisai/agent-harness",
  "version": "0.16.2",
  "description": "An on-device agent for the browser: a tool-calling harness over WebMCP and remote MCP, plus a drop-in chat UI. Decides whether to run a tool, ask for what's missing, or confirm before writing.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    },
    "./a2ui": {
      "types": "./dist/a2ui/index.d.ts",
      "default": "./dist/a2ui/index.js"
    },
    "./tools": {
      "types": "./dist/harness/tools/source.d.ts",
      "default": "./dist/harness/tools/source.js"
    },
    "./media": {
      "types": "./dist/media/index.d.ts",
      "default": "./dist/media/index.js"
    },
    "./guardrails": {
      "types": "./dist/guardrails/index.d.ts",
      "default": "./dist/guardrails/index.js"
    },
    "./policy": {
      "types": "./dist/guardrails/policy.d.ts",
      "default": "./dist/guardrails/policy.js"
    }
  },
  "files": [
    "dist",
    "src",
    "docs/remote-providers.md",
    "docs/guardrails-policy.md",
    "docs/*.svg",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES"
  ],
  "sideEffects": [
    "./dist/ui/index.js",
    "./dist/ui/agent.js",
    "./dist/a2ui/define-once.js",
    "./dist/a2ui/define-restore.js"
  ],
  "scripts": {
    "build:css": "tailwindcss -i src/ui/agent.tw.css -o .tw/agent.css --minify && node scripts/css-to-ts.mjs",
    "build": "npm run build:css && tsc -p tsconfig.json",
    "typecheck": "npm run build:css && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "sync:spec": "node scripts/sync-renderer-spec.mjs",
    "size": "node scripts/size-budget.mjs",
    "build:cdn": "node scripts/build-cdn.mjs",
    "size:cdn": "node scripts/size-budget.mjs --cdn",
    "smoke:cdn": "node bench/runner/cdn-smoke.mjs",
    "check:contained": "node bench/runner/contained-check.mjs",
    "cdn:publish": "node scripts/publish-cdn.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "webmcp",
    "mcp",
    "agent",
    "on-device",
    "llm",
    "gemma",
    "a2ui",
    "schema.org",
    "nxis"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nxisai/agent-harness.git"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@a2ui/lit": "^0.10.3",
    "@a2ui/web_core": "^0.10.6",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "lit": "^3.3.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "esbuild": "^0.21.5",
    "happy-dom": "^15.11.7",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "homepage": "https://github.com/nxisai/agent-harness#readme",
  "bugs": {
    "url": "https://github.com/nxisai/agent-harness/issues"
  }
}
